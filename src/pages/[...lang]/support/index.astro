---
import { Picture } from "astro:assets";
import Base from "../../../layouts/Base.astro";
import Ornament from "../../../components/Ornament.astro";
import Say from "../../../components/Say.astro";
import explain from "../../../assets/mascot/guide_explain.webp";
import { config } from "../../../config";
import { app, t } from "../../../i18n";
import { langPaths, type Lang } from "../../../i18n/languages";

export const getStaticPaths = langPaths;
const { lang } = Astro.props as { lang: Lang };
const dict = t(lang);
const s = dict.support;
const appText = app(lang);
const sections = [{ id: "basics", title: s.basicsTitle, items: s.basics }, ...appText.faq];
---
<Base lang={lang} page="support" title={dict.meta.supportTitle} description={dict.meta.supportDescription}>
  <div class="container page">
    <header class="top">
      <div>
        <h1>{appText.strings["help.title"]}</h1>
        <Ornament />
        <p class="intro">{s.intro}</p>
      </div>
      <div class="mascot-wrap float" data-vt="narra"><Picture src={explain} alt="" widths={[200, 320, 440]} sizes="200px" formats={["avif"]} fallbackFormat="webp" loading="eager" class="mascot" /></div>
    </header>

    <section class="contact" aria-labelledby="contact-title">
      <h2 id="contact-title">{s.contactTitle}</h2>
      <ul role="list">
        <li>
          <a class="channel press" href={`mailto:${config.supportEmail}`}>
            <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" focusable="false">
              <path d="M3.5 6.5h17v11h-17Zm0 .5 8.5 6.5L20.5 7" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" />
            </svg>
            <span>
              <strong>{config.supportEmail}</strong>
              <span class="hint">{s.emailNote}</span>
            </span>
          </a>
        </li>
        <li>
          <a class="channel press" href={config.discordUrl} rel="noopener">
            <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" focusable="false">
              <path d="M5 5.5h14a1.5 1.5 0 0 1 1.5 1.5v8A1.5 1.5 0 0 1 19 16.5h-7l-4.5 3.5v-3.5H5A1.5 1.5 0 0 1 3.5 15V7A1.5 1.5 0 0 1 5 5.5Z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" />
            </svg>
            <span>
              <strong>{s.discordTitle}</strong>
              <span class="hint">{s.discordNote}</span>
            </span>
          </a>
        </li>
      </ul>
    </section>

    <section class="faq" aria-labelledby="faq-title">
      <h2 id="faq-title">{s.faqTitle}</h2>
      {
        sections.map((section) => (
          <div class="group">
            <h3>{section.title}</h3>
            {section.items.map((item) => (
              <details>
                <summary>
                  <span>{item.q}</span>
                  <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true" focusable="false">
                    <path d="M5 7.5l5 5 5-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </summary>
                <p>{item.a}</p>
              </details>
            ))}
          </div>
        ))
      }
    </section>

    <section class="report" aria-labelledby="report-title">
      <h2 id="report-title">{s.reportTitle}</h2>
      <p>{s.reportIntro}</p>
      <ol>
        {s.reportSteps.map((step) => <li>{step}</li>)}
      </ol>
      <Say text={s.reportCrash} />
    </section>
  </div>
</Base>

<style>
  .page {
    max-inline-size: calc(52rem + 2 * var(--gutter));
    padding-block-start: calc(var(--header-height) + var(--s-8));
  }
  .top {
    display: flex;
    flex-wrap: wrap-reverse;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-5);
  }
  h1 {
    font-size: var(--fs-h2);
    margin-block-end: var(--s-4);
  }
  .intro {
    margin-block-start: var(--s-4);
    font-size: var(--fs-lead);
    max-inline-size: 30rem;
  }
  .mascot {
    inline-size: 180px;
    aspect-ratio: 1;
  }
  .mascot :global(img) {
    inline-size: 100%;
    block-size: 100%;
  }
  h2 {
    font-size: clamp(1.6rem, 1.3rem + 1vw, 2.2rem);
  }
  section {
    margin-block-start: var(--s-9);
  }
  .contact ul {
    display: grid;
    gap: var(--s-3);
    margin-block-start: var(--s-4);
    list-style: none;
  }
  .channel {
    display: flex;
    align-items: center;
    gap: var(--s-4);
    min-block-size: 64px;
    padding: var(--s-4) var(--s-5);
    border-radius: var(--r-card);
    border: 1px solid var(--c-stroke-strong);
    color: var(--c-text);
    text-decoration: none;
    transition: border-color var(--dur-fast) var(--ease-out);
  }
  .channel:hover {
    border-color: var(--c-accent);
  }
  .channel svg {
    flex: none;
    color: var(--c-accent);
  }
  .channel > span {
    display: grid;
  }
  .channel strong {
    overflow-wrap: anywhere;
  }
  .hint {
    color: var(--c-text-2);
    font-size: var(--fs-sm);
  }
  @media (min-width: 720px) {
    .contact ul {
      grid-template-columns: 1fr 1fr;
    }
  }
  .group {
    margin-block-start: var(--s-7);
  }
  h3 {
    margin-block-end: var(--s-2);
    font-size: var(--fs-sm);
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--c-accent);
  }
  :global(:lang(ar)) h3,
  :global(:lang(fa)) h3,
  :global(:lang(ja)) h3,
  :global(:lang(ko)) h3,
  :global(:lang(zh-Hans)) h3,
  :global(:lang(zh-Hant)) h3 {
    letter-spacing: 0;
    text-transform: none;
  }
  details {
    border-block-end: 1px solid var(--c-stroke);
  }
  details:first-of-type {
    border-block-start: 1px solid var(--c-stroke);
  }
  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-4);
    min-block-size: 56px;
    padding-block: var(--s-3);
    cursor: pointer;
    list-style: none;
    font-weight: 700;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary svg {
    flex: none;
    color: var(--c-accent);
    transition: transform var(--dur) var(--ease-out);
  }
  details[open] summary svg {
    transform: rotate(180deg);
  }
  summary:hover span {
    color: var(--c-accent);
  }
  summary span {
    transition: color var(--dur-fast) var(--ease-out);
  }
  @media (prefers-reduced-motion: no-preference) {
    details[open] p {
      animation: answer-in 260ms var(--ease-out);
    }
  }
  @keyframes answer-in {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
  }
  details p {
    padding-block-end: var(--s-4);
    color: var(--c-text-2);
    max-inline-size: 42rem;
  }
  .report p {
    margin-block-start: var(--s-3);
  }
  .report ol {
    display: grid;
    gap: var(--s-2);
    margin-block-start: var(--s-3);
    padding-inline-start: var(--s-6);
  }
  .report li::marker {
    color: var(--c-accent);
    font-weight: 800;
  }
</style>

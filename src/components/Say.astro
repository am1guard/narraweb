---
// One line from Narra in a small visual-novel text window. With `type`, the line types
// itself out once when it scrolls into view (src/scripts/motion.ts); the full text is
// always in the DOM and the typed copy is hidden from assistive technology.
interface Props {
  text: string;
  class?: string;
  type?: boolean;
}
const { text, class: className, type = true } = Astro.props;
---
<figure class:list={["say", className]} data-type={type ? "" : undefined}>
  <figcaption class="say-name">Narra</figcaption>
  <blockquote class="say-text">
    <p class="say-line"><span class="say-full">{text}</span><span class="say-typed" aria-hidden="true"></span></p>
  </blockquote>
</figure>

<style>
  .say {
    position: relative;
    margin-block-start: var(--s-5);
    padding: var(--s-6) var(--s-5) var(--s-4);
    border-radius: var(--r-card);
    background: var(--c-dialogue);
    border: 1px solid var(--c-dialogue-stroke);
    max-inline-size: var(--text-max);
  }
  .say-name {
    position: absolute;
    inset-block-start: 0;
    inset-inline-start: var(--s-5);
    transform: translateY(-50%);
    padding: 2px var(--s-3);
    border-radius: var(--r-pill);
    background: var(--c-nametag);
    border: 1px solid var(--c-dialogue-stroke);
    color: #fff;
    font-family: var(--font-display);
    font-weight: var(--display-weight);
    font-size: 1.0625rem;
    line-height: 1.25;
  }
  .say-text {
    margin: 0;
    font-size: var(--fs-lead);
    line-height: 1.5;
  }
  .say-line {
    position: relative;
  }
  .say-typed {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  :global(.type-ready) .say[data-type]:not(.is-typed) .say-full {
    color: transparent;
  }
  :global(.type-ready) .say[data-type].is-typing {
    cursor: pointer;
  }
</style>

---
// A small footer: name and tagline with the links on one line, the fine print in one block
// under it. Narra wanders along its top edge (FooterNarra), in the gap above the line, so
// she never covers the links or the text.
import FooterNarra from "./FooterNarra.astro";
import { config } from "../config";
import { pathFor, type Lang } from "../i18n/languages";
import { app, type Dict } from "../i18n";

interface Props {
  lang: Lang;
  dict: Dict;
}
const { lang, dict } = Astro.props;
const year = new Date(`${config.lastUpdated}T12:00:00Z`).getUTCFullYear();
---
<footer class="site-footer" data-loop>
  <div class="container">
    <div class="edge">
      <FooterNarra />
    </div>
    <div class="row">
      <p class="about">
        <span class="name">Narra</span>
        <span class="tagline">{app(lang).strings["help.about.tagline"]}</span>
      </p>
      <nav aria-label={dict.nav.support}>
        <ul role="list" class="links">
          <li><a class="press" href={pathFor(lang, "support")}>{dict.nav.support}</a></li>
          <li><a class="press" href={pathFor(lang, "privacy")}>{dict.nav.privacy}</a></li>
          <li><a class="press" href={pathFor(lang, "terms")}>{dict.nav.terms}</a></li>
          <li><a class="press" href={config.discordUrl} rel="noopener">Discord</a></li>
          <li><a class="press" href={`mailto:${config.supportEmail}`}>{dict.footer.email}</a></li>
        </ul>
      </nav>
    </div>
    <p class="fine">
      © {year} Narra. {dict.footer.madeBy} {dict.footer.independent} {dict.footer.trademarks}
    </p>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    /* Room above the line for Narra (her tallest pose is about 1.3 times --walker). */
    margin-block-start: max(var(--section-gap), calc(var(--walker) * 1.32 + var(--s-6)));
    padding-block: var(--s-4) var(--s-6);
    border-block-start: 1px solid var(--c-stroke-strong);
    background: color-mix(in srgb, var(--c-surface) 55%, var(--c-bg));
    /* Her wide drifting pose may reach past the page edge: clip it sideways only. */
    overflow-x: clip;
    overflow-y: visible;
  }
  .container {
    position: relative;
  }
  /* A zero-height strip on the footer's top line, as wide as the content: Narra's path. */
  .edge {
    position: absolute;
    inset-block-start: calc(var(--s-4) * -1 - 1px);
    inset-inline: var(--gutter);
    block-size: 0;
    pointer-events: none;
  }
  .row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-1) var(--s-6);
  }
  .about {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 var(--s-3);
    min-inline-size: 0;
  }
  .name {
    font-family: var(--font-display);
    font-weight: var(--display-weight);
    font-size: 1.5rem;
    line-height: 1.2;
  }
  .tagline {
    color: var(--c-text-2);
    font-size: var(--fs-sm);
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--s-1);
    margin: 0;
    margin-inline: calc(var(--s-3) * -1);
    list-style: none;
  }
  .links a {
    display: inline-flex;
    align-items: center;
    min-block-size: var(--touch);
    padding-inline: var(--s-3);
    border-radius: var(--r-control);
    color: var(--c-text);
    font-size: var(--fs-sm);
    font-weight: 700;
    text-decoration: none;
  }
  .links a:hover {
    background: color-mix(in srgb, var(--c-text) 10%, transparent);
  }
  .fine {
    margin-block-start: var(--s-2);
    padding-block-start: var(--s-3);
    border-block-start: 1px solid var(--c-stroke);
    color: var(--c-text-2);
    font-size: var(--fs-xs);
    line-height: 1.55;
  }
</style>

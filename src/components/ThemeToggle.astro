---
// Light/dark switch. The page follows the system until the visitor picks one; the
// choice is kept in localStorage (wrapped in try/catch, the page works without it).
interface Props {
  toLight: string;
  toDark: string;
}
const { toLight, toDark } = Astro.props;
---
<button class="theme press" type="button" data-theme-toggle data-to-light={toLight} data-to-dark={toDark} aria-label={toLight}>
  <svg class="sun" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false">
    <circle cx="12" cy="12" r="4.2" fill="none" stroke="currentColor" stroke-width="1.8" />
    <path d="M12 2.5v2.2M12 19.3v2.2M2.5 12h2.2M19.3 12h2.2M5.3 5.3l1.6 1.6M17.1 17.1l1.6 1.6M5.3 18.7l1.6-1.6M17.1 6.9l1.6-1.6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
  </svg>
  <svg class="moon" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false">
    <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" />
  </svg>
</button>

<script>
  // Theme switch. With view transitions the new theme opens as a circle from the button
  // (about 560 ms); otherwise colours fade for 300 ms; with Reduce Motion it's instant.
  const root = document.documentElement;
  const media = window.matchMedia("(prefers-color-scheme: light)");
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)");
  const current = () => (root.dataset.theme as "light" | "dark" | undefined) ?? (media.matches ? "light" : "dark");
  const sync = () => {
    for (const button of document.querySelectorAll<HTMLButtonElement>("[data-theme-toggle]")) {
      button.setAttribute("aria-label", current() === "dark" ? button.dataset.toLight! : button.dataset.toDark!);
    }
  };
  for (const button of document.querySelectorAll<HTMLButtonElement>("[data-theme-toggle]")) {
    button.addEventListener("click", () => {
      const next = current() === "dark" ? "light" : "dark";
      const apply = () => {
        root.dataset.theme = next;
        try {
          localStorage.setItem("narra-theme", next);
        } catch {
          /* storage unavailable: the choice lasts for this page only */
        }
        sync();
      };
      if (reduce.matches) return apply();
      if (!document.startViewTransition) {
        root.classList.add("theme-fade");
        apply();
        window.setTimeout(() => root.classList.remove("theme-fade"), 360);
        return;
      }
      const r = button.getBoundingClientRect();
      const x = r.left + r.width / 2;
      const y = r.top + r.height / 2;
      const radius = Math.hypot(Math.max(x, innerWidth - x), Math.max(y, innerHeight - y));
      root.classList.add("theme-vt");
      const transition = document.startViewTransition(apply);
      transition.ready
        .then(() =>
          root.animate(
            { clipPath: [`circle(0px at ${x}px ${y}px)`, `circle(${radius}px at ${x}px ${y}px)`] },
            { duration: 560, easing: "cubic-bezier(0.22, 0.8, 0.24, 1)", pseudoElement: "::view-transition-new(root)" },
          ),
        )
        .catch(() => {});
      transition.finished.finally(() => root.classList.remove("theme-vt"));
    });
  }
  media.addEventListener("change", sync);
  sync();
</script>

<style>
  .theme {
    display: grid;
    place-items: center;
    inline-size: var(--touch);
    block-size: var(--touch);
    border: 1px solid transparent;
    border-radius: var(--r-control);
    background: transparent;
    color: var(--c-text);
    cursor: pointer;
    touch-action: manipulation;
    transition: background-color var(--dur-fast) var(--ease-out);
  }
  .theme:hover {
    background: color-mix(in srgb, var(--c-text) 10%, transparent);
  }
  .sun {
    display: block;
  }
  @media (prefers-reduced-motion: no-preference) {
    .theme:hover svg {
      rotate: 18deg;
      transition: rotate var(--dur) var(--ease-spring);
    }
    .theme svg {
      transition: rotate var(--dur) var(--ease-out);
    }
  }
  .moon {
    display: none;
  }
  :global(:root[data-theme="light"]) .sun {
    display: none;
  }
  :global(:root[data-theme="light"]) .moon {
    display: block;
  }
  @media (prefers-color-scheme: light) {
    :global(:root:not([data-theme="dark"])) .sun {
      display: none;
    }
    :global(:root:not([data-theme="dark"])) .moon {
      display: block;
    }
  }
</style>

---
// The thirteen Ren'Py engines Narra ships (scripts/configure_xcodeproj.py in the app),
// grouped by Python generation. 8.5.4 and 8.6.0 are built from pre-release packages.
import type { Dict } from "../i18n";

interface Props {
  dict: Dict;
}
const { dict } = Astro.props;
const PY2 = ["7.4.11", "7.5.3", "7.6.3", "7.7.3", "7.8.7"];
const PY3 = ["8.0.3", "8.1.3", "8.2.3", "8.3.7", "8.4.1", "8.5.3", "8.5.4", "8.6.0"];
const PRE = new Set(["8.5.4", "8.6.0"]);
const e = dict.chapters.engine;
const bands = [
  { label: e.py2, versions: PY2, key: "py2" },
  { label: e.py3, versions: PY3, key: "py3" },
];
---
<figure class="timeline">
  <figcaption class="caption">{e.timelineLabel}</figcaption>
  <div class="bands">
    {
      bands.map((band) => (
        <div class:list={["band", band.key]} style={`--count:${band.versions.length}`}>
          <ol role="list">
            {band.versions.map((v) => (
              <li class:list={{ pre: PRE.has(v) }}>
                <span class="dot" aria-hidden="true" />
                <span class="ver" dir="ltr">{v}</span>
                {PRE.has(v) && (
                  <>
                    <svg class="moon" viewBox="0 0 16 16" width="12" height="12" aria-hidden="true" focusable="false">
                      <path d="M13 9.6A5.6 5.6 0 0 1 6.4 3a5.6 5.6 0 1 0 6.6 6.6Z" fill="currentColor" />
                    </svg>
                    <span class="sr-only">({e.preRelease})</span>
                  </>
                )}
              </li>
            ))}
          </ol>
          <p class="band-label">{band.label}</p>
        </div>
      ))
    }
  </div>
  <p class="legend" aria-hidden="true">
    <svg class="moon" viewBox="0 0 16 16" width="12" height="12" focusable="false">
      <path d="M13 9.6A5.6 5.6 0 0 1 6.4 3a5.6 5.6 0 1 0 6.6 6.6Z" fill="currentColor" />
    </svg>
    {e.preRelease}
  </p>
</figure>

<style>
  .timeline {
    margin-block-start: var(--s-8);
  }
  .caption {
    font-weight: 800;
    font-size: var(--fs-sm);
    color: var(--c-text-2);
  }
  .bands {
    display: grid;
    gap: var(--s-5);
    margin-block-start: var(--s-5);
  }
  ol {
    position: relative;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(3.6rem, 1fr));
    gap: var(--s-3) var(--s-2);
    margin: 0;
    list-style: none;
  }
  li {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--s-2);
    font-variant-numeric: tabular-nums;
  }
  .dot {
    inline-size: 14px;
    block-size: 14px;
    border-radius: 50%;
    background: var(--c-bg);
    border: 2px solid var(--c-accent);
    box-shadow: 0 0 0 4px var(--c-bg);
  }
  .py3 .dot {
    background: var(--c-accent);
  }
  .ver {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    color: var(--c-text);
  }
  .pre .ver {
    color: var(--c-text-2);
  }
  .moon {
    display: inline-block;
    color: var(--c-glow);
    vertical-align: -1px;
  }
  li .moon {
    margin-block-start: calc(-1 * var(--s-1));
  }
  .band-label {
    margin-block-start: var(--s-3);
    padding-block-start: var(--s-2);
    border-block-start: 1px solid var(--c-stroke-strong);
    font-size: var(--fs-xs);
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--c-text-2);
    text-align: center;
  }
  .legend {
    margin-block-start: var(--s-4);
    font-size: var(--fs-xs);
    color: var(--c-text-2);
    display: flex;
    align-items: center;
    gap: var(--s-2);
  }
  @media (min-width: 900px) {
    .bands {
      grid-template-columns: 5fr 8fr;
      gap: var(--s-4);
    }
    ol {
      grid-template-columns: repeat(var(--count), 1fr);
    }
    ol::before {
      content: "";
      position: absolute;
      inset-block-start: 6px;
      inset-inline: 0;
      block-size: 2px;
      background: linear-gradient(to right, var(--c-stroke-strong), color-mix(in srgb, var(--c-accent) 60%, transparent));
      z-index: -1;
    }
    .bands {
      isolation: isolate;
    }
  }
</style>

---
// Chapter "saves": a small stack of save slots like the app's save manager, with Narra
// hugging her cloud on top. Thumbnails are abstract night scenes (no game art). On first
// view the cards fan out one by one and the iCloud badge pops in.
import { Picture } from "astro:assets";
import cloudNarra from "../assets/brand/narra-cloud.webp";
import { app, type Dict } from "../i18n";
import type { Lang } from "../i18n/languages";

interface Props {
  lang: Lang;
  dict: Dict;
}
const { lang, dict } = Astro.props;
const s = app(lang).strings;
const page = s["saves.group.page %lld"].replace("%lld", "1");
const slot = (n: number) => s["saves.slot.number %lld"].replace("%lld", String(n));
const cards = [
  { n: 1, hue: "a" },
  { n: 2, hue: "b" },
  { n: 3, hue: "c" },
];
---
<figure class="savecards" data-seq aria-label={dict.chapters.saves.cardsLabel}>
  <div class="narra float" aria-hidden="true">
    <Picture src={cloudNarra} alt="" widths={[200, 300, 420]} sizes="(min-width: 900px) 210px, 150px" formats={["avif"]} fallbackFormat="webp" quality={78} loading="lazy" decoding="async" />
  </div>
  <div class="stack" aria-hidden="true">
    <p class="group">{page}</p>
    {
      cards.map((c, i) => (
        <div class:list={["card", `card-${i}`]} style={`--n:${i}`}>
          <span class:list={["thumb", c.hue]}>
            <svg viewBox="0 0 100 56" preserveAspectRatio="none" focusable="false">
              <circle cx={c.n === 2 ? 26 : 74} cy="17" r="8" fill="#f6dcff" fill-opacity="0.85" />
              <path d="M0 56V40l12-6 10 5 14-9 12 7 14-8 12 6 12-5 14 7v19Z" fill="#120c1b" fill-opacity="0.75" />
            </svg>
          </span>
          <span class="meta">
            <span class="slot">{slot(c.n)}</span>
            <span class="bar" />
          </span>
        </div>
      ))
    }
    <span class="cloud">
      <svg viewBox="0 0 24 24" width="16" height="16" focusable="false">
        <path d="M7.5 18.5h9.8a3.7 3.7 0 0 0 .4-7.4 5.4 5.4 0 0 0-10.5 1.2 3.1 3.1 0 0 0 .3 6.2Z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" />
        <path d="M9.6 14.4l2 2 3.6-3.8" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
      iCloud
    </span>
  </div>
</figure>

<style>
  .savecards {
    position: relative;
    display: grid;
    justify-items: center;
    margin: 0;
    padding-block-start: var(--s-4);
  }
  .narra {
    position: relative;
    z-index: 2;
    inline-size: clamp(150px, 12vw + 60px, 210px);
    margin-block-end: -34px;
  }
  .narra :global(img) {
    inline-size: 100%;
    block-size: auto;
  }
  .stack {
    position: relative;
    display: grid;
    gap: var(--s-2);
    inline-size: min(100%, 300px);
    padding: var(--s-6) var(--s-4) var(--s-4);
    border-radius: var(--r-hero);
    background: var(--c-surface);
    border: 1px solid var(--c-stroke-strong);
    box-shadow: var(--shadow-soft);
  }
  .group {
    font-size: var(--fs-xs);
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--c-text-2);
  }
  .card {
    display: grid;
    grid-template-columns: 84px 1fr;
    align-items: center;
    gap: var(--s-3);
    padding: var(--s-2);
    border-radius: var(--r-control);
    background: color-mix(in srgb, var(--c-accent) 7%, var(--c-surface));
    border: 1px solid var(--c-stroke);
  }
  .thumb {
    display: block;
    aspect-ratio: 16 / 9;
    border-radius: var(--r-badge);
    overflow: hidden;
  }
  .thumb svg {
    inline-size: 100%;
    block-size: 100%;
  }
  .a {
    background: linear-gradient(160deg, #3b2361, #7442d6);
  }
  .b {
    background: linear-gradient(160deg, #2a1d4a, #a04db8);
  }
  .c {
    background: linear-gradient(160deg, #1d1529, #5c3a9e);
  }
  .meta {
    display: grid;
    gap: 6px;
  }
  .slot {
    font-weight: 800;
    font-size: var(--fs-sm);
  }
  .bar {
    display: block;
    block-size: 6px;
    inline-size: 70%;
    border-radius: 6px;
    background: var(--c-stroke-strong);
  }
  .cloud {
    position: absolute;
    inset-block-start: calc(-1 * var(--s-3));
    inset-inline-end: var(--s-4);
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px var(--s-3);
    border-radius: var(--r-pill);
    background: var(--c-nametag);
    color: #fff;
    font-size: var(--fs-xs);
    font-weight: 800;
  }
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .savecards:not(.is-in) .card,
    :global(.js) .savecards:not(.is-in) .cloud {
      opacity: 0;
    }
    .savecards.is-in .card {
      animation: card-in 560ms var(--ease-spring) calc(200ms + var(--n) * 140ms) both;
    }
    .savecards.is-in .cloud {
      animation: cloud-in 520ms var(--ease-spring) 760ms both;
    }
  }
  @keyframes card-in {
    from {
      opacity: 0;
      transform: translateY(-26px) rotate(-3deg) scale(0.96);
    }
  }
  @keyframes cloud-in {
    from {
      opacity: 0;
      transform: scale(0.6);
    }
  }
</style>

---
// One chapter of the story: numbered title with a scene-break ornament, a line from Narra
// (typed out once), a short lead and at most four features as a quiet list (no card grid).
// The art column holds the chapter's own illustration (slot "art"), the Narra pose, or,
// once screenshots are in, the app screen in a phone frame.
//
// Motion: the head, Narra's box, lead and list rise in one after another as they enter the
// view; the art pops in and then floats; the big numeral drifts with a slow parallax.
import { Picture } from "astro:assets";
import type { ImageMetadata } from "astro";
import Ornament from "./Ornament.astro";
import Say from "./Say.astro";
import PhoneFrame from "./PhoneFrame.astro";
import { chapterLabel, chapterNumeral, type Lang } from "../i18n/languages";
import { firstScreen, SCREENS, type ScreenName } from "../lib/screens";
import { sparklePath } from "../lib/sparkle";

interface Props {
  lang: Lang;
  n: number;
  id: string;
  title: string;
  say: string;
  lead: string;
  items: { t: string; d: string }[];
  mascot?: ImageMetadata;
  /** Screenshot names to try, in order (src/lib/screens.ts). */
  screens?: ScreenName[];
  /** A second screenshot shown behind the first, fanned out (only when it exists). */
  backScreen?: ScreenName;
  /** Small note under the phone, e.g. that the games in a sample library are made up. */
  screenNote?: string;
  screenAlt?: string;
  showScreens: boolean;
  /** No art column: the chapter brings its own full-width illustration in the default slot. */
  wide?: boolean;
}
const { lang, n, id, title, say, lead, items, mascot, screens, backScreen, screenNote, screenAlt = "", showScreens, wide = false } = Astro.props;
const side = n % 2 === 1 ? "end" : "start";
const shot = showScreens && screens ? firstScreen(lang, screens) : undefined;
const useScreen = showScreens && screens !== undefined && screens.length > 0;
const back = useScreen && backScreen ? firstScreen(lang, [backScreen]) : undefined;
const customArt = Astro.slots.has("art");
const art = !wide && (useScreen || customArt || mascot);
---
<section id={`chapter-${n}`} class:list={["chapter", `chapter-${id}`]} aria-labelledby={`chapter-${n}-title`} data-chapter={id} data-loop>
  <div class:list={["container", "grid", { "has-art": art }]} data-side={side}>
    <div class="text">
      <header class="head">
        <p class="label" data-rise style="--i:0">{chapterLabel(lang, n)}</p>
        <h2 id={`chapter-${n}-title`} data-rise style="--i:1">{title}</h2>
        <div data-rise style="--i:2"><Ornament /></div>
      </header>
      <div data-rise style="--i:3"><Say text={say} /></div>
      <p class="lead" data-rise style="--i:4">{lead}</p>
      {Astro.slots.has("aside") && <div data-rise style="--i:5"><slot name="aside" /></div>}
      <ul class="features" role="list">
        {
          items.map((item, i) => (
            <li data-rise style={`--i:${i + 5}`}>
              <svg class="bullet" viewBox="0 0 16 16" width="14" height="14" aria-hidden="true" focusable="false">
                <path d={sparklePath(8, 8, 7)} fill="currentColor" />
              </svg>
              <h3>{item.t}</h3>
              <p>{item.d}</p>
            </li>
          ))
        }
      </ul>
    </div>
    {
      art && (
        <div class="art">
          <div class="art-inner" data-pop>
            <span class="numeral" aria-hidden="true">{chapterNumeral(lang, n)}</span>
            {useScreen ? (
              <figure class:list={["shots", { pair: back }]}>
                {back && (
                  <PhoneFrame image={back.image} alt="" orientation={SCREENS[back.name]} name={back.name} class="back-phone" />
                )}
                <PhoneFrame image={shot?.image} alt={screenAlt} orientation={SCREENS[shot?.name ?? screens![0]]} name={shot?.name ?? screens![0]} class="front-phone" />
                {mascot && (
                  <div class="companion float" aria-hidden="true">
                    <Picture src={mascot} alt="" widths={[160, 240, 320]} sizes="140px" formats={["avif"]} fallbackFormat="webp" quality={78} loading="lazy" decoding="async" />
                  </div>
                )}
                {screenNote && <figcaption class="shot-note">{screenNote}</figcaption>}
              </figure>
            ) : customArt ? (
              <slot name="art" />
            ) : (
              <div class="float">
                <Picture
                  src={mascot!}
                  alt=""
                  widths={[240, 360, 520, 720]}
                  sizes="(min-width: 900px) 360px, 220px"
                  formats={["avif"]}
                  fallbackFormat="webp"
                  quality={78}
                  loading="lazy"
                  decoding="async"
                  class="mascot"
                />
              </div>
            )}
          </div>
        </div>
      )
    }
  </div>
  <slot />
</section>

<style>
  .chapter {
    position: relative;
    padding-block-start: var(--section-gap);
    scroll-margin-block-start: var(--s-4);
    view-timeline: --chapter block;
  }
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .numeral {
        animation: numeral-drift linear both;
        animation-timeline: --chapter;
        animation-range: cover;
      }
    }
  }
  @keyframes numeral-drift {
    from {
      transform: translateY(70px);
    }
    to {
      transform: translateY(-70px);
    }
  }
  .grid {
    display: grid;
    gap: var(--s-7);
  }
  .text {
    max-inline-size: var(--text-max);
  }
  .label {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.0625rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--c-accent);
    line-height: 1.2;
  }
  :global(:lang(ar)) .label,
  :global(:lang(fa)) .label,
  :global(:lang(ja)) .label,
  :global(:lang(ko)) .label,
  :global(:lang(zh-Hans)) .label,
  :global(:lang(zh-Hant)) .label {
    letter-spacing: 0;
    font-size: var(--fs-label);
  }
  h2 {
    margin-block: var(--s-2) var(--s-4);
    font-size: var(--fs-h2);
  }
  .lead {
    margin-block-start: var(--s-6);
    font-size: var(--fs-lead);
    color: var(--c-text);
  }
  .features {
    margin-block-start: var(--s-7);
    list-style: none;
    display: grid;
  }
  .features li {
    display: grid;
    grid-template-columns: 14px 1fr;
    column-gap: var(--s-3);
    padding-block: var(--s-4);
    border-block-start: 1px solid var(--c-stroke);
  }
  .features li:last-child {
    border-block-end: 1px solid var(--c-stroke);
  }
  .bullet {
    grid-row: 1 / span 2;
    margin-block-start: 0.4em;
    color: var(--c-accent);
  }
  h3 {
    margin: 0;
    font-size: var(--fs-h3);
    font-weight: 800;
    line-height: 1.4;
  }
  .features p {
    color: var(--c-text-2);
    margin-block-start: 2px;
  }
  .art {
    display: flex;
    justify-content: center;
  }
  .art-inner {
    position: relative;
    display: flex;
    justify-content: center;
    inline-size: 100%;
  }
  .art-inner::before {
    content: "";
    position: absolute;
    inset: 8%;
    border-radius: 50%;
    background: radial-gradient(circle, color-mix(in srgb, var(--c-glow) calc(var(--glow-opacity) * 110%), transparent) 0, transparent 70%);
    z-index: -1;
  }
  .mascot {
    inline-size: 220px;
    aspect-ratio: 1;
    object-fit: contain;
  }
  /* Screenshots: the phone, an optional second phone fanned out behind it, and the
     chapter's Narra pose sitting small at the phone's lower corner. */
  .shots {
    position: relative;
    display: grid;
    justify-items: center;
    margin: 0;
  }
  .shots :global(.front-phone) {
    position: relative;
    z-index: 1;
  }
  .shots.pair {
    padding-inline-end: 18%;
  }
  .shots :global(.back-phone) {
    position: absolute;
    inset-block-start: 6%;
    inset-inline-end: 0;
    scale: 0.86;
    rotate: 6deg;
    opacity: 0.9;
    transform-origin: bottom center;
  }
  :global([dir="rtl"]) .shots :global(.back-phone) {
    rotate: -6deg;
  }
  .companion {
    position: absolute;
    z-index: 2;
    inset-block-end: 4%;
    inset-inline-start: -14%;
    inline-size: clamp(96px, 6vw + 50px, 140px);
    pointer-events: none;
  }
  .companion :global(img) {
    inline-size: 100%;
    block-size: auto;
  }
  .shot-note {
    margin-block-start: var(--s-3);
    color: var(--c-text-2);
    font-size: var(--fs-xs);
    text-align: center;
  }
  .numeral {
    position: absolute;
    inset-block-start: -0.2em;
    inset-inline-start: 0;
    z-index: -1;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(7rem, 5rem + 7vw, 13rem);
    line-height: 1;
    color: var(--c-accent);
    opacity: 0.13;
    white-space: nowrap;
    pointer-events: none;
    user-select: none;
  }

  /* Mobile: the art comes first, small, then the text. */
  .art {
    order: -1;
  }

  @media (min-width: 900px) {
    .grid.has-art {
      grid-template-columns: minmax(0, 1fr) minmax(0, 0.8fr);
      align-items: start;
      column-gap: var(--s-9);
    }
    .grid.has-art[data-side="start"] {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1fr);
    }
    .art {
      order: 0;
      align-self: stretch;
    }
    .grid[data-side="start"] .art {
      order: -1;
    }
    .art-inner {
      position: sticky;
      inset-block-start: 14vh;
      align-self: start;
      margin-block-start: var(--s-9);
    }
    .mascot {
      inline-size: var(--mascot-chapter);
    }
    .numeral {
      inset-block-start: -0.35em;
      inset-inline-start: -0.32em;
    }
  }
</style>

---
// Where to drop games so Narra finds them: Files > On My iPhone > Narra > Games.
interface Props {
  label: string;
  path: string[];
}
const { label, path } = Astro.props;
---
<div class="files" data-seq>
  <p class="files-label">{label}</p>
  <ol class="crumbs" role="list">
    {
      path.map((part, i) => (
        <li style={`--n:${i}`}>
          {i > 0 && (
            <svg class="sep flip" viewBox="0 0 16 16" width="12" height="12" aria-hidden="true" focusable="false">
              <path d="M6 3l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          )}
          <span class:list={["part", { last: i === path.length - 1 }]}>
            {i === path.length - 1 && (
              <svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true" focusable="false">
                <path d="M2.5 5.5a2 2 0 0 1 2-2h3.6l1.8 2h5.6a2 2 0 0 1 2 2v7a2 2 0 0 1-2 2h-11a2 2 0 0 1-2-2Z" fill="currentColor" />
              </svg>
            )}
            {part}
          </span>
        </li>
      ))
    }
  </ol>
</div>

<style>
  .files {
    margin-block-start: var(--s-6);
    padding: var(--s-4) var(--s-5);
    border-radius: var(--r-card);
    border: 1px dashed var(--c-stroke-strong);
  }
  .files-label {
    font-size: var(--fs-sm);
    color: var(--c-text-2);
  }
  .crumbs {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-1) var(--s-2);
    margin-block-start: var(--s-2);
    list-style: none;
  }
  li {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
  }
  .sep {
    color: var(--c-text-2);
  }
  :global([dir="rtl"]) .flip {
    transform: scaleX(-1);
  }
  .part {
    display: inline-flex;
    align-items: center;
    gap: var(--s-1);
    font-weight: 700;
  }
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .files:not(.is-in) li {
      opacity: 0;
    }
    .files.is-in li {
      animation: crumb-in 420ms var(--ease-out) calc(var(--n) * 130ms) both;
    }
    .files.is-in .part.last {
      animation: games-glow 900ms var(--ease-spring) 640ms both;
    }
  }
  @keyframes crumb-in {
    from {
      opacity: 0;
      transform: translateX(-10px);
    }
  }
  @keyframes games-glow {
    0% {
      transform: scale(1);
      box-shadow: 0 0 0 0 color-mix(in srgb, var(--c-accent) 0%, transparent);
    }
    45% {
      transform: scale(1.12);
      box-shadow: 0 0 0 6px color-mix(in srgb, var(--c-accent) 22%, transparent);
    }
    100% {
      transform: scale(1);
      box-shadow: 0 0 0 0 color-mix(in srgb, var(--c-accent) 0%, transparent);
    }
  }
  .part.last {
    display: inline-flex;
    padding: 2px var(--s-3);
    border-radius: var(--r-badge);
    background: color-mix(in srgb, var(--c-accent) 18%, transparent);
    color: var(--c-accent);
  }
</style>

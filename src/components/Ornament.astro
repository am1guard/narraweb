---
// Scene-break ornament under chapter titles: hairline, sparkle, hairline.
import { sparklePath } from "../lib/sparkle";
---
<div class="ornament" aria-hidden="true">
  <span class="line"></span>
  <svg viewBox="0 0 40 24" width="40" height="24" focusable="false">
    <path d={sparklePath(20, 12, 10)} fill="var(--c-accent)" />
    <path d={sparklePath(5, 6, 3)} fill="var(--c-glow)" opacity="0.7" />
    <path d={sparklePath(35, 18, 2.6)} fill="var(--c-glow)" opacity="0.6" />
  </svg>
  <span class="line"></span>
</div>

<style>
  .ornament {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    max-inline-size: 280px;
    color: var(--c-accent);
  }
  .line {
    flex: 1;
    block-size: 1px;
    background: linear-gradient(to var(--to-end, right), transparent, var(--c-stroke-strong));
  }
  .line:last-child {
    background: linear-gradient(to var(--to-end, right), var(--c-stroke-strong), transparent);
  }
  :global([dir="rtl"]) .ornament {
    --to-end: left;
  }
</style>

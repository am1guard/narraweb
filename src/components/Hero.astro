---
// Opening scene: the night town backdrop (dark theme), Narra floating with her book, and
// a visual-novel text window where she introduces herself.
import { Picture } from "astro:assets";
import backdrop from "../assets/brand/hero-backdrop.webp";
import narra from "../assets/brand/hero-narra.webp";
import DialogueBox from "./DialogueBox.astro";
import AppStoreButton from "./AppStoreButton.astro";
import { config } from "../config";
import { app, type Dict } from "../i18n";
import type { Lang } from "../i18n/languages";

interface Props {
  lang: Lang;
  dict: Dict;
}
const { lang, dict } = Astro.props;
---
<section class="hero" aria-labelledby="hero-title">
  <div class="scene" aria-hidden="true">
    <Picture
      src={backdrop}
      alt=""
      widths={[640, 960, 1280, 1916]}
      sizes="(min-width: 1100px) 100vw, (min-width: 600px) 160vw, 300vw"
      formats={["avif"]} fallbackFormat="webp"
      quality={52}
      loading="eager"
      fetchpriority="high"
      decoding="async"
      class="backdrop"
    />
    <div class="veil"></div>
  </div>

  <div class="container inner">
    <div class="copy">
      <p class="eyebrow">{dict.hero.eyebrow}</p>
      <h1 id="hero-title">{app(lang).strings["help.about.tagline"]}</h1>
      <div class="actions">
        <AppStoreButton dict={dict} />
        <a class="discord" href={config.discordUrl} rel="noopener">
          <span>{dict.cta.discord}</span>
          <svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true" focusable="false" class="flip-rtl">
            <path d="M7 4l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
      </div>
    </div>

    <div class="stage">
      <Picture
        src={narra}
        alt={dict.hero.sceneAlt}
        widths={[280, 400, 560]}
        sizes="(min-width: 900px) 330px, 62vw"
        formats={["avif"]} fallbackFormat="webp"
        quality={58}
        loading="eager"
        fetchpriority="high"
        decoding="async"
        class="sprite"
      />
      <DialogueBox
        name="Narra"
        lines={dict.hero.lines}
        label={dict.hero.dialogueLabel}
        nextLabel={dict.hero.next}
        beginLabel={dict.hero.begin}
        beginHref="#chapter-1"
      />
      <p class="compat">{dict.hero.compat}</p>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    padding-block: calc(var(--header-height) + var(--s-6)) var(--s-8);
    overflow: hidden;
  }
  .scene {
    position: absolute;
    inset: 0;
    z-index: -1;
  }
  .backdrop {
    position: absolute;
    inset: 0;
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    object-position: 84% 0%;
    opacity: var(--backdrop-opacity);
    mask-image: linear-gradient(to bottom, #000 60%, transparent);
  }
  .veil {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to bottom, rgb(18 12 27 / 0.55), rgb(18 12 27 / 0.1) 22%, transparent 42%),
      radial-gradient(ellipse 60% 42% at 50% 26%, rgb(18 12 27 / 0.55), transparent 70%),
      linear-gradient(to bottom, transparent 58%, var(--c-bg) 98%);
    opacity: var(--veil-opacity);
  }
  .inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  .copy {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--s-4);
    max-inline-size: 46rem;
  }
  .copy .eyebrow {
    text-shadow: 0 1px 12px rgb(0 0 0 / 0.5);
  }
  h1 {
    font-size: var(--fs-h1);
    max-inline-size: 18ch;
    text-shadow: 0 2px 24px rgb(0 0 0 / 0.45);
  }
  :root[data-theme="light"] h1,
  :root[data-theme="light"] .copy .eyebrow {
    text-shadow: none;
  }
  @media (prefers-color-scheme: light) {
    :root:not([data-theme="dark"]) h1,
    :root:not([data-theme="dark"]) .copy .eyebrow {
      text-shadow: none;
    }
  }
  :global(:lang(ja)) h1,
  :global(:lang(ko)) h1,
  :global(:lang(zh-Hans)) h1,
  :global(:lang(zh-Hant)) h1 {
    max-inline-size: 14em;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--s-3) var(--s-5);
    margin-block-start: var(--s-3);
  }
  .discord {
    display: inline-flex;
    align-items: center;
    gap: var(--s-1);
    min-block-size: var(--touch);
    padding-inline: var(--s-3);
    border-radius: var(--r-control);
    color: var(--c-text);
    font-weight: 700;
    text-decoration: none;
  }
  .discord:hover {
    background: color-mix(in srgb, var(--c-text) 10%, transparent);
  }
  :global([dir="rtl"]) .flip-rtl {
    transform: scaleX(-1);
  }
  .stage {
    --sprite: min(62vw, 330px);
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    inline-size: min(100%, 52rem);
    margin-block-start: var(--s-4);
  }
  .sprite {
    inline-size: var(--sprite);
    aspect-ratio: 1;
    margin-block-end: calc(var(--sprite) * -0.2);
  }
  .stage :global(.vn) {
    inline-size: 100%;
  }
  .compat {
    margin-block-start: var(--s-4);
    max-inline-size: 40rem;
    color: var(--c-text-2);
    font-size: var(--fs-sm);
  }
  @media (min-width: 1100px) {
    .hero {
      min-block-size: min(100svh, 1000px);
      padding-block-start: calc(var(--header-height) + var(--s-7));
    }
    .backdrop {
      object-position: 50% 30%;
    }
  }
  @media (min-width: 1700px) {
    .backdrop {
      mask-image: linear-gradient(to bottom, #000 60%, transparent), linear-gradient(to right, transparent, #000 9%, #000 91%, transparent);
      mask-composite: intersect;
    }
  }
</style>
